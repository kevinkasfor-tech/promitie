---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Esencia from '../components/Esencia.astro';
import Catalogo from '../components/Catalogo.astro';
import Proceso from '../components/Proceso.astro';
import Aliados from '../components/Aliados.astro';
import Recetario from '../components/Recetario.astro';
import Resenas from '../components/Resenas.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ProductModal from '../components/ProductModal.astro';
import Chatbot from '../components/Chatbot.astro';
---
<Base>
  <Navbar />
  <main>
    <Hero />
    <Esencia />
    <Catalogo />
    <Proceso />
    <Aliados />
    <Recetario />
    <Resenas />
    <Contacto />
