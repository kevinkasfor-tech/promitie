---
import '../styles/global.css';
import '../styles/enhancements.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Promitie Arepas — Hechas con Amor de Hogar',
  description = 'Arepas tradicionales colombianas hechas con maíz 100% seleccionado para disfrutar en casa y optimizar tu negocio. Bogotá, Colombia.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/LOGO.png" />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/png" href="/LOGO.png" />
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
  <slot />
  <script src="../scripts/main.ts"></script>
  <script src="../scripts/animations.ts"></script>
</body>
</html>
