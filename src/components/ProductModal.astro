---
// Modal de detalle de producto (lo controla main.ts)
---
<div class="product-modal-overlay" id="product-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="product-modal-content">
    <button class="close-modal-btn" id="close-modal-btn" aria-label="Cerrar detalle">&times;</button>
    <div class="modal-body">
      <div class="modal-img-col">
        <img src="" id="modal-img" alt="Producto" />
      </div>
      <div class="modal-info-col">
        <span class="modal-badge" id="modal-category">Categoría</span>
        <h2 id="modal-title">Nombre del Producto</h2>
        <p id="modal-desc" class="modal-desc">Descripción</p>

        <div class="modal-benefits">
          <h4><i class="fa-solid fa-leaf"></i> Beneficios Alimenticios</h4>
          <ul id="modal-benefits-list"></ul>
        </div>

        <div class="modal-footer">
          <div class="modal-price-box">
            <span id="modal-units" class="modal-units">Unidades</span>
            <span id="modal-price" class="modal-price">$0</span>
          </div>
          <div id="modal-action-area"></div>
        </div>
      </div>
    </div>
  </div>
</div>
