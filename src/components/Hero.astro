---
// Hero con video principal: prom.webm (nuevo)
// En móvil: vertical promitie.webm
---
<section id="inicio" class="hero">
  <!-- Video principal del hero: prom.webm -->
  <video autoplay muted loop playsinline class="hero-video-bg hero-video-desktop" aria-hidden="true">
    <source src="/prom.webm" type="video/webm" />
  </video>
  <!-- Video móvil (vertical) -->
  <video autoplay muted loop playsinline class="hero-video-bg hero-video-mobile" aria-hidden="true">
    <source src="/verti.webm" type="video/webm" />
  </video>
  <div class="hero-overlay"></div>

  <div class="hero-content">
    <span class="handwritten" style="color: var(--color-gold); font-size: 2.2rem;">Hechas con Amor de Hogar</span>
    <h1>Arepas colombianas para tu mesa y tu negocio</h1>
    <p>Productos de mi tierra, elaborados con recetas regionales — ideales para tu desayuno o para la carta de restaurantes, cafeterías, hoteles y distribuidores.</p>

    <div class="hero-ctas">
      <a href="#catalogo" class="btn btn-primary">Quiero probar las arepas</a>
      <a href="#catalogo" id="hero-b2b-trigger" class="btn btn-outline-white">Tengo un negocio</a>
    </div>
  </div>

  <!-- Indicador de scroll -->
  <a href="#esencia" class="scroll-hint" aria-label="Desplázate para descubrir">
    <svg width="28" height="44" viewBox="0 0 28 44" fill="none" aria-hidden="true">
      <rect x="1.5" y="1.5" width="25" height="41" rx="12.5" stroke="currentColor" stroke-width="2"/>
      <circle class="scroll-hint-dot" cx="14" cy="12" r="3" fill="currentColor"/>
    </svg>
  </a>
</section>

<style>
  /* Video al natural — sin filtros de color */
  .hero-video-desktop {
    opacity: 1;
  }
</style>
